# Copy to tools/publish.env (gitignored) and fill in. Used by tools/publish-apk.sh.
# The ${VAR:=value} form keeps an environment variable of the same name if one is set.
: "${BRIDGIT_PUBLIC_HOST:=downloads.example.com}"     # public host serving bridget/latest.json and the APKs
: "${BRIDGIT_R2_ACCOUNT:=<cloudflare account id>}"
: "${BRIDGIT_R2_BUCKET:=<r2 bucket name>}"
: "${BRIDGIT_R2_TOKEN_ITEM:=<bitwarden item id holding the R2 API token>}"
# : "${BRIDGIT_GH_REPO:=owner/repo}"                  # where GitHub releases go (default sponicgarden/bridgit)
