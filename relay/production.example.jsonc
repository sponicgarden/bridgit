{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridgit-relay",
  "main": "src/worker.mjs",
  "account_id": "394b5de665bbfdea54cdd57be9094762",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "routes": [{ "pattern": "relay.bridgit.cc", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "PHONES", "class_name": "PhoneRelay" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PhoneRelay"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://relay.bridgit.cc",
    "ACCESS_TEAM": "REPLACE_WITH_EXISTING_OWNER_TEAM",
    "ACCESS_AUD": "REPLACE_WITH_OWNER_ONLY_ACCESS_APPLICATION_AUDIENCE",
    "OAUTH_CLIENTS": "{}",
    "ALLOWED_ORIGINS": "[]",
  },
}
