{
  "name": "bridgit",
  "account_id": "9cd3a280a54ce2a5b382602f0247b577",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "bridgit.cc",
      "custom_domain": true
    },
    {
      "pattern": "www.bridgit.cc",
      "custom_domain": true
    }
  ],
  "build": {
    "command": "npm run build"
  },
  "main": "worker.mjs",
  "d1_databases": [
    {
      "binding": "SIGNUPS",
      "database_name": "bridgit-website",
      "database_id": "181e13d5-f52e-446e-b899-39ce34d44217",
      "migrations_dir": "./migrations"
    }
  ],
  // Cloudflare Email Sending for download and alert emails; needs bridgit.cc onboarded under Email Service.
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
