<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets a test run set up pairing and toggles over ADB
     without tapping the screen. Never part of the release APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".DebugSetupReceiver" android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter><action android:name="net.finleg.bridget.debug.SETUP" /></intent-filter>
        </receiver>
    </application>
</manifest>
