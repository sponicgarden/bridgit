<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_main"
    app:startDestination="@id/home">

    <fragment android:id="@+id/home" android:name="net.finleg.bridget.ui.home.HomeFragment" android:label="@string/nav_home" />
    <!-- 1.5 (D26): Interactions tab and detail. -->
    <fragment android:id="@+id/interactions" android:name="net.finleg.bridget.ui.interactions.InteractionsFragment" android:label="@string/nav_interactions" />
    <fragment android:id="@+id/interactionDetail" android:name="net.finleg.bridget.ui.interactions.InteractionDetailFragment">
        <argument android:name="interactionId" app:argType="long" />
    </fragment>
    <!-- City tour (8.25, D30): setup and the running tour. Full screen. -->
    <fragment android:id="@+id/tour" android:name="net.finleg.bridget.ui.tour.TourFragment" />
    <!-- Owner, 30 Oct 2026: Agents is a tab again; Applets lives in the Interactions screen as a subtab. -->
    <fragment android:id="@+id/agents" android:name="net.finleg.bridget.ui.agents.AgentsFragment" android:label="@string/nav_agents" />
    <!-- Not a tab since 1.5 (D26): opened from More, Home's Today card and Agent detail. -->
    <fragment android:id="@+id/activity" android:name="net.finleg.bridget.ui.activity.ActivityFragment" android:label="@string/nav_activity" />
    <fragment android:id="@+id/more" android:name="net.finleg.bridget.ui.more.MoreFragment" android:label="@string/nav_more" />

    <fragment android:id="@+id/agentDetail" android:name="net.finleg.bridget.ui.agents.AgentDetailFragment">
        <argument android:name="agentId" app:argType="string" />
    </fragment>
    <!-- Full-screen flows (no bottom bar). agentId set = show the setup prompt for that agent (rotate / resume). -->
    <fragment android:id="@+id/addAgent" android:name="net.finleg.bridget.ui.addagent.AddAgentFragment">
        <argument android:name="agentId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="fromRotate" app:argType="boolean" android:defaultValue="false" />
    </fragment>
    <fragment android:id="@+id/pairCode" android:name="net.finleg.bridget.ui.addagent.PairCodeFragment" />
    <fragment android:id="@+id/features" android:name="net.finleg.bridget.ui.more.FeaturesFragment" />
    <fragment android:id="@+id/access" android:name="net.finleg.bridget.ui.more.AccessFragment" />
    <!-- Maximum powers: every switch on, then each Android permission in one guided pass. agentId = the agent just given every grant. -->
    <fragment android:id="@+id/powers" android:name="net.finleg.bridget.ui.power.PowersFragment">
        <argument android:name="agentId" app:argType="string" app:nullable="true" android:defaultValue="@null" />
    </fragment>
    <fragment android:id="@+id/settings" android:name="net.finleg.bridget.ui.more.SettingsFragment" />
    <!-- P1b feedback (section 11). reportForm: kind = "bug" | "feature"; optional logEntryId attaches one log entry. -->
    <fragment android:id="@+id/reportForm" android:name="net.finleg.bridget.ui.feedback.ReportFormFragment">
        <argument android:name="kind" app:argType="string" android:defaultValue="bug" />
        <argument android:name="screen" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="screenContext" app:argType="string" app:nullable="true" android:defaultValue="@null" />
        <argument android:name="logEntryId" app:argType="long" android:defaultValue="-1L" />
    </fragment>
    <fragment android:id="@+id/myReports" android:name="net.finleg.bridget.ui.feedback.MyReportsFragment" />
    <fragment android:id="@+id/reportDetail" android:name="net.finleg.bridget.ui.feedback.ReportDetailFragment">
        <argument android:name="reportId" app:argType="long" />
    </fragment>
    <fragment android:id="@+id/whatCan" android:name="net.finleg.bridget.ui.more.WhatCanFragment" />
    <fragment android:id="@+id/firstRun" android:name="net.finleg.bridget.ui.firstrun.FirstRunFragment" />
</navigation>
