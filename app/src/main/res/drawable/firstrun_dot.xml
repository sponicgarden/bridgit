<?xml version="1.0" encoding="utf-8"?>
<!-- First-run page indicator dot (UI-08): filled primary when selected, outline-variant otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item android:gravity="center" android:width="8dp" android:height="8dp">
                <shape android:shape="oval"><solid android:color="?attr/colorPrimary" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:gravity="center" android:width="8dp" android:height="8dp">
                <shape android:shape="oval"><solid android:color="?attr/colorOutlineVariant" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
