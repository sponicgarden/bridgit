    <string name="access_notifications_partly">Capture notifications are turned off</string>

    <string-array name="access_how_notifications">
        <item>Tap Turn on.</item>
        <item>If Android asks, choose \"Allow\".</item>
        <item>If a settings page opens, turn on \"All Bridgit notifications\" and \"Captures\".</item>
        <item>Come back here.</item>
    </string-array>
    <string-array name="access_how_camera">
        <item>Tap Grant.</item>
        <item>Choose \"While using the app\".</item>
        <item>Come back here.</item>
        <item>If App info opens instead, tap Permissions, then Camera, then \"Allow only while using the app\".</item>
    </string-array>
    <string-array name="access_how_mic">
        <item>Tap Grant.</item>
        <item>Choose \"While using the app\".</item>
        <item>Come back here.</item>
        <item>If App info opens instead, tap Permissions, then Microphone, then \"Allow only while using the app\".</item>
    </string-array>
    <string-array name="access_how_photos">
        <item>Tap Grant.</item>
        <item>Choose \"Allow all\", or \"Select photos\" to share only some.</item>
        <item>Come back here.</item>
        <item>To change it later, tap Change, then Permissions, then \"Photos and videos\".</item>
    </string-array>
    <string-array name="access_how_screenshots">
        <item>Tap Turn on. Android opens \"Bridgit screenshots\".</item>
        <item>Turn on \"Use Bridgit screenshots\" and tap Allow.</item>
        <item>If Android says \"Restricted setting\": open Bridgit\'s App info, tap the three dots (top right), tap \"Allow restricted settings\", confirm, then try again.</item>
        <item>Come back here, and turn on Screenshots in Features.</item>
    </string-array>
    <string-array name="access_how_battery">
        <item>Tap Turn on.</item>
        <item>Choose \"Allow\" in the pop-up.</item>
        <item>Come back here.</item>
    </string-array>

