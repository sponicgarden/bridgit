<?xml version="1.0" encoding="utf-8"?>
<!-- Add agent flow (6.2, UI-13, ui-spec 5.4). Full screen, one Fragment, four steps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="@string/addagent_close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/addagent_title" />

    <!-- 4-segment progress indicator -->
    <LinearLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <View android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@drawable/addagent_segment" />
            <View android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/addagent_segment" />
            <View android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/addagent_segment" />
            <View android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/addagent_segment" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal">

            <TextView android:id="@+id/lab1" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="@string/addagent_step_name"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:id="@+id/lab2" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:text="@string/addagent_step_connection"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:id="@+id/lab3" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:text="@string/addagent_step_check"
                android:textAppearance="?attr/textAppearanceBodySmall" />
            <TextView android:id="@+id/lab4" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="4dp" android:layout_weight="1" android:text="@string/addagent_step_prompt"
                android:textAppearance="?attr/textAppearanceBodySmall" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Step 1: Name -->
            <LinearLayout
                android:id="@+id/step_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/addagent_name_heading"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/name_layout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/addagent_name_label"
                    app:counterEnabled="true"
                    app:counterMaxLength="24"
                    app:helperText="@string/addagent_name_helper"
                    app:helperTextEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/name_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName|textCapWords|textNoSuggestions"
                        android:maxLength="24"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/suggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!-- Step 2: Connection (radio cards) -->
            <LinearLayout
                android:id="@+id/step_connection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/conn_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <LinearLayout
                    android:id="@+id/conn_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_direct"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:checkable="true"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="12dp"
                        app:checkedIconTint="?attr/colorPrimary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_computer"
                                app:tint="?attr/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="24dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/addagent_conn_direct"
                                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/addagent_conn_direct_desc"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_userspace"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:checkable="true"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="12dp"
                        app:checkedIconTint="?attr/colorPrimary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_dns"
                                app:tint="?attr/colorPrimary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_marginEnd="24dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/addagent_conn_userspace"
                                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/addagent_conn_userspace_desc"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <!-- Relay is shown only when relay mode is set up (4.4, Q10); not in 1.3.0. -->
                </LinearLayout>
            </LinearLayout>

            <!-- Step 3: Check -->
            <LinearLayout
                android:id="@+id/step_check"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/check_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <include android:id="@+id/check_listener" layout="@layout/addagent_check_row" />
                <include android:id="@+id/check_tailscale" layout="@layout/addagent_check_row" />
                <include android:id="@+id/check_port" layout="@layout/addagent_check_row" />
            </LinearLayout>

            <!-- Step 4 (+5): Setup prompt and waiting -->
            <LinearLayout
                android:id="@+id/step_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/key_gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/addagent_key_gone"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/key_gone_rotate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/addagent_rotate" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/prompt_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/prompt_intro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginTop="1dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lock"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="@string/addagent_prompt_warning"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="26dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/addagent_prompt_risk"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/prompt_card"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainer"
                        app:cardCornerRadius="12dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <androidx.core.widget.NestedScrollView
                                android:id="@+id/prompt_scroll"
                                android:layout_width="match_parent"
                                android:layout_height="280dp"
                                android:contentDescription="@string/addagent_prompt_card_desc"
                                android:fadeScrollbars="false"
                                android:scrollbars="vertical">

                                <TextView
                                    android:id="@+id/prompt_text"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:padding="12dp"
                                    android:textAppearance="@style/TextAppearance.Bridgit.Mono.Prompt"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textIsSelectable="true" />
                            </androidx.core.widget.NestedScrollView>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="32dp"
                                android:layout_gravity="bottom"
                                android:background="@drawable/addagent_prompt_fade"
                                android:importantForAccessibility="no" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/copy_prompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="56dp"
                        android:text="@string/addagent_copy_prompt"
                        app:icon="@drawable/ic_copy"
                        app:iconGravity="textStart" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/share"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/addagent_share"
                            app:icon="@drawable/ic_share"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/qr"
                            style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                            android:layout_width="64dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/addagent_qr"
                            android:minHeight="48dp"
                            android:paddingStart="0dp"
                            android:paddingEnd="0dp"
                            app:icon="@drawable/ic_qr"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Step 5: waiting / connected / no call yet (live region) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/wait_card"
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:id="@+id/wait_indicator"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:importantForAccessibility="noHideDescendants">

                                <View
                                    android:id="@+id/pulse_ring"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/addagent_dot_gold" />

                                <View
                                    android:id="@+id/pulse_dot"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/addagent_dot_gold" />

                                <ImageView
                                    android:id="@+id/wait_icon"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:layout_gravity="center"
                                    android:visibility="gone" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/wait_title"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                                <TextView
                                    android:id="@+id/wait_sub"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textAppearance="?attr/textAppearanceBodyMedium" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/troubleshoot"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:text="@string/addagent_troubleshooting"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom bar: Back / Next on steps 1-3, Done on step 4 -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addagent_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addagent_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/done_outlined"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addagent_done"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/done_filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/addagent_done"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
