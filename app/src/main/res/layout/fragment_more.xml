<?xml version="1.0" encoding="utf-8"?>
<!-- More (UI-07, ui-spec 5.13). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        app:title="@string/more_title" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- D26: Activity moved here from the bottom bar. -->
            <include android:id="@+id/open_activity" layout="@layout/more_row" />
            <include android:id="@+id/features" layout="@layout/more_row" />
            <include android:id="@+id/access" layout="@layout/more_row" />
            <include android:id="@+id/relay" layout="@layout/more_row" />
            <include android:id="@+id/settings" layout="@layout/more_row" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- FBK-01, FBK-09 -->
            <include android:id="@+id/report_bug" layout="@layout/more_row" />
            <include android:id="@+id/request_feature" layout="@layout/more_row" />
            <include android:id="@+id/my_reports" layout="@layout/more_row" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- UPD-02 -->
            <include android:id="@+id/check_updates" layout="@layout/more_row" />
            <include android:id="@+id/about" layout="@layout/more_row" />
            <include android:id="@+id/what_can" layout="@layout/more_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
